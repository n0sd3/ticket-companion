<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="ticket_companion_secure_prefs.xml" />
        <exclude domain="database" path="ticket_companion.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ticket_companion_secure_prefs.xml" />
        <exclude domain="database" path="ticket_companion.db" />
    </device-transfer>
</data-extraction-rules>
